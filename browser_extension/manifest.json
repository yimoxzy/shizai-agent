{
  "manifest_version": 3,
  "name": "Shizai MCP Browser Bridge",
  "version": "0.1.11",
  "key": "",
  "description": "A small browser bridge for visual element inspection and verified collection locators.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service_worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/core.js", "content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Shizai MCP Browser Bridge" }
}
