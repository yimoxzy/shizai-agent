      "turns": [
        {
          "request": "打开 {entry}，查询“手机”，采集所有页的商品编号、商品名称、价格、销量原文、销量口径、商品链接，按首次出现顺序保存且不重复，保存为 UTF-8 CSV 到 {output}。",
          "oracle": "shop:手机",
          "budget_seconds": 240,
          "budget_calls": 24
        },
        {
          "request": "同一个流程改查“笔记本”，保留全部页和字段，输出到同一个文件。",
          "oracle": "shop:笔记本",
          "budget_seconds": 120,
          "budget_calls": 12
        }
      ],
      "extension": ".csv",
      "edit_mode": "parameters",
      "entry": "/shop",
      "manual_review_required": true
    },
