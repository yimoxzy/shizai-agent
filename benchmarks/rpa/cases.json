{
  "schema": "rpa-component-benchmark/v1",
  "version": "1.0",
  "cases": [
    {
      "id": "web-single",
      "group": "web",
      "title": "单页商品查询",
      "environment": "fixture",
      "facts": {
        "resource": "product_listing",
        "operation": "collect"
      },
      "capabilities": [
        "navigate",
        "input",
        "click",
        "extract",
        "output"
      ],
      "turns": [
        {
          "request": "打开 {entry}，查询“耳机”，采集全部结果的商品编号、商品名称、价格、销量原文、销量口径、商品链接，保存为 UTF-8 CSV 到 {output}。",
          "oracle": "shop:耳机",
          "budget_seconds": 240,
          "budget_calls": 24
        },
        {
          "request": "同一个流程改成查询“相机”，保留列和顺序，输出到同一个文件。",
          "oracle": "shop:相机",
          "budget_seconds": 120,
          "budget_calls": 12
        }
      ],
      "extension": ".csv",
      "edit_mode": "parameters",
      "entry": "/shop",
      "manual_review_required": true
    },
    {
      "id": "web-pages",
      "group": "web",
      "title": "查询后分页",
      "environment": "fixture",
      "facts": {
        "resource": "product_listing",
        "operation": "collect"
      },
      "capabilities": [
        "navigate",
